#cloud-config
users:
  - name: __SSH_USER__
    shell: /bin/bash
    groups: [sudo]
    sudo: ['ALL=(ALL) NOPASSWD:ALL']
    lock_passwd: true
    ssh_authorized_keys:
      - __SSH_PUBLIC_KEY__
disable_root: true
ssh_pwauth: false
package_update: true
packages:
  - python3
  - sudo
growpart:
  mode: auto
  devices: ['/']
resize_rootfs: true
